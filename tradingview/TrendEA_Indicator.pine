//@version=6
// TrendEA — Indicator (signals + alerts)
// Same logic as the TrendEA strategy, but as an overlay indicator: shows buy/sell
// signals with suggested ATR stop loss / take profit levels, a trend cloud and a
// status panel, and exposes alert conditions for TradingView alerts.
indicator("TrendEA Signals", shorttitle = "TrendEA", overlay = true, max_labels_count = 300, max_lines_count = 300)

// ───── Inputs ─────
grpS = "Signals"
fastLen    = input.int(20, "Fast EMA", minval = 1, group = grpS)
slowLen    = input.int(50, "Slow EMA", minval = 2, group = grpS)
rsiLen     = input.int(14, "RSI period", minval = 1, group = grpS)
rsiBuyMin  = input.float(50.0, "Buy only if RSI above", group = grpS)
rsiSellMax = input.float(50.0, "Sell only if RSI below", group = grpS)
sessionStr = input.session("0000-0000", "Trading session (exchange time)", group = grpS)

grpL = "Levels"
atrLen     = input.int(14, "ATR period", minval = 1, group = grpL)
slMult     = input.float(2.0, "Stop loss = ATR ×", minval = 0.1, step = 0.1, group = grpL)
tpMult     = input.float(3.0, "Take profit = ATR × (0 = none)", minval = 0, step = 0.1, group = grpL)
showLevels = input.bool(true, "Draw SL / TP lines", group = grpL)
levelBars  = input.int(15, "Line length (bars)", minval = 1, group = grpL)

grpV = "Display"
showCloud  = input.bool(true, "Trend cloud", group = grpV)
showPanel  = input.bool(true, "Status panel", group = grpV)

// ───── Calculations ─────
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

inSession  = not na(time(timeframe.period, sessionStr))
buySignal  = ta.crossover(fastEma, slowEma)  and rsi > rsiBuyMin  and inSession
sellSignal = ta.crossunder(fastEma, slowEma) and rsi < rsiSellMax and inSession
bullTrend  = fastEma > slowEma

// ───── Plots ─────
pFast = plot(fastEma, "Fast EMA", color = color.new(color.teal, 0), linewidth = 2)
pSlow = plot(slowEma, "Slow EMA", color = color.new(color.orange, 0), linewidth = 2)
fill(pFast, pSlow, color = showCloud ? (bullTrend ? color.new(color.green, 85) : color.new(color.red, 85)) : na, title = "Trend cloud")

plotshape(buySignal,  "Buy",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(sellSignal, "Sell", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small)

// SL / TP guide lines drawn once the signal bar has closed
drawLevels(bool isBuy) =>
    sl = isBuy ? close - atr * slMult : close + atr * slMult
    line.new(bar_index, sl, bar_index + levelBars, sl, color = color.red, style = line.style_dashed)
    label.new(bar_index + levelBars, sl, "SL " + str.tostring(sl, format.mintick),
         style = label.style_label_left, color = color.new(color.red, 20), textcolor = color.white, size = size.tiny)
    if tpMult > 0
        tp = isBuy ? close + atr * tpMult : close - atr * tpMult
        line.new(bar_index, tp, bar_index + levelBars, tp, color = color.green, style = line.style_dashed)
        label.new(bar_index + levelBars, tp, "TP " + str.tostring(tp, format.mintick),
             style = label.style_label_left, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny)

if showLevels and barstate.isconfirmed
    if buySignal
        drawLevels(true)
    if sellSignal
        drawLevels(false)

// ───── Status panel ─────
var table panel = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 30), border_width = 1)
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "Trend", text_color = color.white)
    table.cell(panel, 1, 0, bullTrend ? "Bullish" : "Bearish", text_color = bullTrend ? color.lime : color.red)
    table.cell(panel, 0, 1, "RSI", text_color = color.white)
    table.cell(panel, 1, 1, str.tostring(rsi, "#.0"), text_color = color.white)
    table.cell(panel, 0, 2, "ATR", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(atr, format.mintick), text_color = color.white)
    table.cell(panel, 0, 3, "Session", text_color = color.white)
    table.cell(panel, 1, 3, inSession ? "Open" : "Closed", text_color = inSession ? color.lime : color.gray)

// ───── Alerts ─────
alertcondition(buySignal,  "TrendEA Buy",  "TrendEA BUY {{ticker}} @ {{close}}")
alertcondition(sellSignal, "TrendEA Sell", "TrendEA SELL {{ticker}} @ {{close}}")
alertcondition(buySignal or sellSignal, "TrendEA Any signal", "TrendEA signal on {{ticker}} @ {{close}}")
