//@version=6
// TrendScalperXAU: e njejta logjike si robot/TrendScalperXAU.mq5
// Trendi: EMA 50 / EMA 200 ne 15m. Hyrja: pullback te EMA 20 (grafik 5m).
// Cdo hyrje = 2 pozicione: TP1 20 pips, TP2 50 pips, SL 30 pips, break-even pas TP1.
indicator("TrendScalperXAU", shorttitle = "TSXAU", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ───── Inputet ─────
grpTP    = "TP / SL (ne pips)"
pipSize  = input.float(0.10, "1 pip =", step = 0.01, group = grpTP, tooltip = "Ne ar 1 pip = 0.10$ levizje cmimi")
tp1Pips  = input.int(20, "TP1", minval = 1, group = grpTP)
tp2Pips  = input.int(50, "TP2", minval = 1, group = grpTP)
slPips   = input.int(30, "SL", minval = 1, group = grpTP)
useBE    = input.bool(true, "Break-even pas TP1", group = grpTP)
beOffset = input.int(1, "Break-even + pips", minval = 0, group = grpTP)

grpTrend = "Trendi"
trendTF  = input.timeframe("15", "Timeframe i trendit", group = grpTrend)
fastLen  = input.int(50, "EMA e shpejte", minval = 1, group = grpTrend)
slowLen  = input.int(200, "EMA e ngadalte", minval = 1, group = grpTrend)

grpEntry = "Hyrja"
entryLen = input.int(20, "EMA e hyrjes (pullback)", minval = 1, group = grpEntry)
useSess  = input.bool(false, "Vetem brenda orarit", group = grpEntry)
sess     = input.session("0300-2100", "Orari (ora e burses ne grafik)", group = grpEntry)

grpView  = "Pamja"
lotSize  = input.float(0.01, "Loti per pozicion (per llogaritjen ne $)", step = 0.01, group = grpView)
showEMA  = input.bool(true, "Shfaq EMA-t", group = grpView)
showBg   = input.bool(true, "Ngjyros sfondin sipas trendit", group = grpView)

// ───── Trendi ne 15m (vetem qirinj te mbyllur, pa repaint) ─────
htfFast  = request.security(syminfo.tickerid, trendTF, ta.ema(close, fastLen)[1], lookahead = barmerge.lookahead_on)
htfSlow  = request.security(syminfo.tickerid, trendTF, ta.ema(close, slowLen)[1], lookahead = barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, trendTF, close[1], lookahead = barmerge.lookahead_on)

trend = htfFast > htfSlow and htfClose > htfFast ? 1 : htfFast < htfSlow and htfClose < htfFast ? -1 : 0

// ───── Sinjali i hyrjes ─────
emaEntry = ta.ema(close, entryLen)
inSess   = not useSess or not na(time(timeframe.period, sess))
buySig   = trend == 1  and low  <= emaEntry and close > emaEntry and close > open
sellSig  = trend == -1 and high >= emaEntry and close < emaEntry and close < open

// ───── Simulimi i trade-ve ─────
var int   dir       = 0      // 1 = buy, -1 = sell, 0 = pa pozicion
var float entry     = na
var float sl        = na
var float tp1       = na
var float tp2       = na
var bool  tp1Hit    = false
var float setupPips = 0.0
var int   entryBar  = na
var line  lnEntry   = na
var line  lnSL      = na
var line  lnTP1     = na
var line  lnTP2     = na

var int   setups    = 0
var int   wins      = 0
var int   losses    = 0
var float totalPips = 0.0

bool closedNow = false

// Daljet kontrollohen nga qiriri pas hyrjes. Nese SL dhe TP preken ne te njejtin qiri, llogaritet SL (rasti me i keq).
if dir != 0 and bar_index > entryBar
    hitSL  = dir == 1 ? low <= sl : high >= sl
    hitTP1 = dir == 1 ? high >= tp1 : low <= tp1
    hitTP2 = dir == 1 ? high >= tp2 : low <= tp2
    if not tp1Hit
        if hitSL
            setupPips -= 2 * slPips
            closedNow := true
        else if hitTP1
            tp1Hit := true
            setupPips += tp1Pips
            if hitTP2
                setupPips += tp2Pips
                closedNow := true
            else if useBE
                sl := entry + dir * beOffset * pipSize
                line.set_x2(lnSL, bar_index)
                lnSL := line.new(bar_index, sl, bar_index, sl, color = color.orange, width = 2)
    else
        if hitSL
            setupPips += dir * (sl - entry) / pipSize
            closedNow := true
        else if hitTP2
            setupPips += tp2Pips
            closedNow := true

if dir != 0
    line.set_x2(lnEntry, bar_index)
    line.set_x2(lnSL, bar_index)
    line.set_x2(lnTP1, bar_index)
    line.set_x2(lnTP2, bar_index)

if closedNow
    totalPips += setupPips
    if setupPips > 0
        wins += 1
    else
        losses += 1
    resultText = (setupPips > 0 ? "+" : "") + str.tostring(setupPips, "#.#") + " pips"
    label.new(bar_index, dir == 1 ? high : low, resultText,
         style = dir == 1 ? label.style_label_down : label.style_label_up,
         color = setupPips > 0 ? color.new(color.green, 10) : color.new(color.red, 10),
         textcolor = color.white, size = size.small)
    dir    := 0
    tp1Hit := false

// Hyrja: vetem ne qiri te mbyllur dhe kur nuk ka pozicion te hapur
bool enteredLong  = false
bool enteredShort = false
if dir == 0 and barstate.isconfirmed and inSess and (buySig or sellSig)
    dir       := buySig ? 1 : -1
    entry     := close
    sl        := entry - dir * slPips  * pipSize
    tp1       := entry + dir * tp1Pips * pipSize
    tp2       := entry + dir * tp2Pips * pipSize
    tp1Hit    := false
    setupPips := 0.0
    entryBar  := bar_index
    setups    += 1
    lnEntry   := line.new(bar_index, entry, bar_index, entry, color = color.gray)
    lnSL      := line.new(bar_index, sl,    bar_index, sl,    color = color.red, width = 2)
    lnTP1     := line.new(bar_index, tp1,   bar_index, tp1,   color = color.teal, style = line.style_dashed)
    lnTP2     := line.new(bar_index, tp2,   bar_index, tp2,   color = color.green, width = 2)
    enteredLong  := dir == 1
    enteredShort := dir == -1

// ───── Grafiku ─────
plot(showEMA ? emaEntry : na, "EMA hyrje",           color = color.orange)
plot(showEMA ? htfFast  : na, "EMA trend e shpejte", color = color.blue)
plot(showEMA ? htfSlow  : na, "EMA trend e ngadalte", color = color.purple, linewidth = 2)
bgcolor(showBg and trend == 1 ? color.new(color.green, 92) : showBg and trend == -1 ? color.new(color.red, 92) : na)

plotshape(enteredLong,  "Buy",  shape.labelup,   location.belowbar, color.green, text = "BUY",  textcolor = color.white, size = size.small)
plotshape(enteredShort, "Sell", shape.labeldown, location.abovebar, color.red,   text = "SELL", textcolor = color.white, size = size.small)

alertcondition(enteredLong,  "TSXAU Buy",  "TrendScalperXAU: BUY")
alertcondition(enteredShort, "TSXAU Sell", "TrendScalperXAU: SELL")

// ───── Tabela e rezultateve ─────
var table stats = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    usdPerPip = pipSize * 100 * lotSize   // 1 lot ar = 100 ons
    closed    = wins + losses
    winRate   = closed > 0 ? 100.0 * wins / closed : 0.0
    txt       = color.white
    table.cell(stats, 0, 0, "TrendScalperXAU", text_color = txt, text_size = size.small)
    table.cell(stats, 1, 0, trend == 1 ? "Trend LART" : trend == -1 ? "Trend POSHTE" : "Pa trend",
         text_color = trend == 1 ? color.lime : trend == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(stats, 0, 1, "Hyrje",           text_color = txt, text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(setups), text_color = txt, text_size = size.small)
    table.cell(stats, 0, 2, "Fitues",          text_color = txt, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(wins),   text_color = color.lime, text_size = size.small)
    table.cell(stats, 0, 3, "Humbes",          text_color = txt, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(losses), text_color = color.red, text_size = size.small)
    table.cell(stats, 0, 4, "Win rate",        text_color = txt, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(winRate, "#.#") + " %", text_color = txt, text_size = size.small)
    table.cell(stats, 0, 5, "Pips gjithsej",   text_color = txt, text_size = size.small)
    table.cell(stats, 1, 5, str.tostring(totalPips, "#.#"), text_color = totalPips >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(stats, 0, 6, "Fitimi (" + str.tostring(lotSize) + " lot x2)", text_color = txt, text_size = size.small)
    table.cell(stats, 1, 6, str.tostring(totalPips * usdPerPip, "#.##") + " $", text_color = totalPips >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(stats, 0, 7, "Pozicion i hapur", text_color = txt, text_size = size.small)
    table.cell(stats, 1, 7, dir == 1 ? "BUY" : dir == -1 ? "SELL" : "-", text_color = txt, text_size = size.small)
